{
  "name": "opendock",
  "private": true,
  "version": "0.2.0",
  "description": "A privacy-first, open-source dock and taskbar replacement for Windows",
  "license": "MIT",
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev": "pnpm --filter @opendock/desktop tauri dev",
    "build": "pnpm --filter @opendock/desktop build",
    "build:desktop": "pnpm --filter @opendock/desktop tauri build --no-bundle",
    "bundle:desktop": "pnpm --filter @opendock/desktop tauri build",
    "dev:web": "pnpm --filter @opendock/web dev",
    "build:web": "pnpm --filter @opendock/web build",
    "lighthouse:web": "pnpm --filter @opendock/web lighthouse",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "fmt:check": "pnpm --filter @opendock/desktop fmt:check",
    "test:rust": "pnpm --filter @opendock/desktop test:rust"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}

---
type Props = {
  eyebrow?: string;
  title: string;
  lead?: string;
};

const { eyebrow, title, lead } = Astro.props;
---

<header class="page-head">
  <div class="container">
    {eyebrow ? <p class="eyebrow">{eyebrow}</p> : null}
    <h1 class="title">{title}</h1>
    {lead ? <p class="lead">{lead}</p> : null}
    <slot />
  </div>
</header>

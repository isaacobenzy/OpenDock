---
import { moreNav, primaryNav } from "../data/nav";

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="OpenDock home">
      <img
        class="brand-icon"
        src="/icons/icon-32.png"
        width="32"
        height="32"
        alt=""
        decoding="async"
      />
      <span>OpenDock</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      {
        primaryNav.map((group) => (
          <div class="nav-group">
            <button
              type="button"
              class="nav-trigger"
              aria-haspopup="true"
              aria-expanded="false"
            >
              {group.label}
            </button>
            <div class="nav-panel" role="menu" aria-label={group.label}>
              {group.links.map((link) => (
                <a
                  href={link.href}
                  role="menuitem"
                  aria-current={isActive(link.href) ? "page" : undefined}
                >
                  {link.label}
                  {link.description ? <small>{link.description}</small> : null}
                </a>
              ))}
            </div>
          </div>
        ))
      }

      <div class="nav-group">
        <button
          type="button"
          class="nav-trigger"
          aria-haspopup="true"
          aria-expanded="false"
        >
          More
        </button>
        <div class="nav-panel" role="menu" aria-label="More">
          {
            moreNav.map((link) => (
              <a
                href={link.href}
                role="menuitem"
                target={link.href.startsWith("http") ? "_blank" : undefined}
                rel={link.href.startsWith("http") ? "noreferrer" : undefined}
              >
                {link.label}
                {link.description ? <small>{link.description}</small> : null}
              </a>
            ))
          }
        </div>
      </div>
    </nav>

    <div class="header-actions">
      <a class="btn btn-secondary" href="/docs/">Docs</a>
      <a class="btn btn-primary" href="/docs/#download">Download</a>
      <details class="mobile-menu">
        <summary class="menu-toggle">Menu</summary>
        <nav class="mobile-nav" aria-label="Mobile">
          {
            primaryNav.map((group) => (
              <section>
                <h2>{group.label}</h2>
                {group.links.map((link) => (
                  <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
                    {link.label}
                  </a>
                ))}
              </section>
            ))
          }
          <section>
            <h2>More</h2>
            {moreNav.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </section>
        </nav>
      </details>
    </div>
  </div>
</header>

---
import { isCurrent, primaryNav } from "../data/nav";
import { site } from "../data/site";
import BrandMark from "./BrandMark.astro";
import Icon from "./Icon.astro";

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <BrandMark />
      <span>OpenDock</span>
    </a>

    <nav class="primary-nav" aria-label="Main">
      <ul>
        {
          primaryNav.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href, pathname) ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a class="icon-link" href={site.repo} aria-label="OpenDock on GitHub">
        <Icon name="github" size={20} />
      </a>
      <a class="btn btn-primary btn-small" href="/download/">
        <Icon name="download" size={16} />
        Download
      </a>
      <details class="mobile-menu">
        <summary>Menu</summary>
        <nav aria-label="Main">
          <ul>
            {
              primaryNav.map((link) => (
                <li>
                  <a href={link.href} aria-current={isCurrent(link.href, pathname) ? "page" : undefined}>
                    {link.label}
                  </a>
                </li>
              ))
            }
            <li><a href="/download/">Download</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

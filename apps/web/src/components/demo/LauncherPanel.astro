---
import { pinnedDemoApps } from "../../data/demo";
import Icon from "../Icon.astro";

type Props = { id?: string; hidden?: boolean };
const { id, hidden = false } = Astro.props;

const results = [
  { name: "Notes", icon: "note", tone: 3 },
  { name: "Notifications", icon: "bell", tone: 6 },
  { name: "Network settings", icon: "wifi", tone: 1 },
] as const;
---

<div class="panel panel--launcher" id={id} hidden={hidden} role={id ? "dialog" : undefined} aria-label={id ? "Start" : undefined}>
  <label class="search-field">
    <Icon name="search" size={16} />
    <input type="search" data-launcher-search placeholder="Search apps" aria-label="Search apps" autocomplete="off" />
  </label>
  <p class="panel-label">Pinned</p>
  <ul class="pin-grid" aria-label="Pinned apps">
    {
      pinnedDemoApps.map((app) => (
        <li data-launcher-item={app.name}>
          <span class="dk-tile" data-tone={app.tone}>
            <Icon name={app.icon} size={18} />
          </span>
          <span>{app.name}</span>
        </li>
      ))
    }
  </ul>
  <p class="panel-label">Best matches</p>
  <ul class="result-list" aria-label="Search results">
    {
      results.map((r, i) => (
        <li data-launcher-item={r.name} class:list={{ "is-selected": i === 0 }}>
          <span class="dk-tile is-small" data-tone={r.tone}>
            <Icon name={r.icon} size={14} />
          </span>
          {r.name}
          {i === 0 ? <kbd>Enter</kbd> : null}
        </li>
      ))
    }
  </ul>
  <div class="power-row" aria-label="Power">
    <span title="Lock"><Icon name="lock" size={15} /></span>
    <span title="Sleep"><Icon name="moon" size={15} /></span>
    <span title="Restart"><Icon name="restart" size={15} /></span>
    <button type="button" class="is-confirm" data-power>
      <Icon name="power" size={15} />
      <span data-power-label>Shut down</span>
    </button>
  </div>
</div>

<script>
  for (const panel of document.querySelectorAll<HTMLElement>(".panel--launcher")) {
    const search = panel.querySelector<HTMLInputElement>("[data-launcher-search]");
    const power = panel.querySelector<HTMLButtonElement>("[data-power]");
    const label = panel.querySelector<HTMLElement>("[data-power-label]");
    search?.addEventListener("input", () => {
      const needle = search.value.trim().toLowerCase();
      for (const item of panel.querySelectorAll<HTMLElement>("[data-launcher-item]")) {
        const name = (item.dataset.launcherItem ?? "").toLowerCase();
        item.hidden = needle.length > 0 && !name.includes(needle);
      }
    });
    power?.addEventListener("click", () => {
      const armed = power.getAttribute("aria-pressed") === "true";
      power.setAttribute("aria-pressed", armed ? "false" : "true");
      if (label) label.textContent = armed ? "Shut down" : "Click again to shut down";
    });
  }
</script>

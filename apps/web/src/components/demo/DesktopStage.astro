---
import { heroDock } from "../../data/demo";
import AppsPanel from "./AppsPanel.astro";
import ClockPanel from "./ClockPanel.astro";
import Dock from "./Dock.astro";
import LauncherPanel from "./LauncherPanel.astro";

const code = [
  [8, 22, 30],
  [8, 14, 40, 12],
  [14, 26],
  [14, 18, 34],
  [20, 44],
  [20, 12, 24, 18],
  [14, 10],
  [8, 6],
  [],
  [8, 22, 28],
  [14, 36, 20],
  [14, 16],
  [8, 6],
];
---

<section class="stage" data-stage aria-labelledby="stage-title">
  <h2 id="stage-title" class="sr-only">Interactive preview of OpenDock</h2>
  <div class="wallpaper" aria-hidden="true"></div>

  <div class="win win--back narrow-hide" aria-hidden="true">
    <div class="win-bar"><span class="win-title">Browser</span><span class="win-ctrl"></span></div>
    <div class="win-page">
      <span class="page-hero"></span>
      <span class="page-line" style="--w: 70%"></span>
      <span class="page-line" style="--w: 54%"></span>
      <span class="page-cards"><span></span><span></span><span></span></span>
    </div>
  </div>

  <div class="win win--front" aria-hidden="true">
    <div class="win-bar"><span class="win-title">dock.rs — opendock</span><span class="win-ctrl"></span></div>
    <div class="win-code">
      <span class="gutter"></span>
      <span class="lines">
        {
          code.map((tokens) => (
            <span class="code-line">
              {tokens.map((w, i) => (
                <span class="tok" data-k={i % 4} style={`--w: ${w}`} />
              ))}
            </span>
          ))
        }
      </span>
    </div>
  </div>

  <div class="legacy-taskbar" aria-hidden="true">
    <span class="legacy-icons"><span></span><span></span><span></span><span></span><span></span><span></span></span>
    <span class="legacy-tray"><span></span><span></span></span>
  </div>

  <div class="stage-dock">
    <Dock items={heroDock} interactive label="OpenDock, interactive demo" />
  </div>

  <LauncherPanel id="flyout-start" hidden />
  <AppsPanel id="flyout-apps" hidden />
  <ClockPanel id="flyout-clock" hidden />
</section>

<script>
  const stage = document.querySelector<HTMLElement>("[data-stage]");

  if (stage) {
    const triggers = Array.from(stage.querySelectorAll<HTMLButtonElement>("button[data-flyout]"));
    let open: { trigger: HTMLButtonElement; panel: HTMLElement } | null = null;

    const place = (trigger: HTMLElement, panel: HTMLElement) => {
      const bounds = stage.getBoundingClientRect();
      const anchor = trigger.getBoundingClientRect();
      const width = panel.offsetWidth;
      const centre = anchor.left + anchor.width / 2 - bounds.left;
      const left = Math.min(Math.max(centre - width / 2, 12), bounds.width - width - 12);
      panel.style.left = `${Math.max(left, 12)}px`;
    };

    const close = (returnFocus = false) => {
      if (!open) return;
      open.panel.hidden = true;
      open.trigger.setAttribute("aria-expanded", "false");
      if (returnFocus) open.trigger.focus();
      open = null;
    };

    for (const trigger of triggers) {
      trigger.addEventListener("click", (event) => {
        event.stopPropagation();
        const panel = document.getElementById(trigger.dataset.flyout ?? "");
        if (!panel) return;
        const same = open?.trigger === trigger;
        close();
        if (same) return;
        panel.hidden = false;
        place(trigger, panel);
        trigger.setAttribute("aria-expanded", "true");
        open = { trigger, panel };
      });
    }

    document.addEventListener("click", (event) => {
      if (open && !open.panel.contains(event.target as Node)) close();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") close(true);
    });
    window.addEventListener("resize", () => {
      if (open) place(open.trigger, open.panel);
    });

    stage.classList.add("is-interactive");
  }
</script>

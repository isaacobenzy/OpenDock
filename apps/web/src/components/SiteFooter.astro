---
import { footerNav } from "../data/nav";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p>
        <strong>OpenDock</strong> is a privacy-first, open-source dock and widget platform for
        Windows. No account required. MIT licensed.
      </p>
      <p>© {year} OpenDock Contributors</p>
    </div>
    {
      footerNav.map((group) => (
        <div>
          <h2>{group.label}</h2>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</footer>

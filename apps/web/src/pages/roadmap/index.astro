---
import PageHead from "../../components/PageHead.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Content } from "../../../../../ROADMAP.md";
import { repoLinks } from "../../data/site";
---

<BaseLayout
  title="Roadmap"
  description="Where OpenDock is going: 1.0 for Windows, a widget SDK, and Linux and macOS versions."
>
  <PageHead
    eyebrow="Direction, not dates"
    title="Roadmap"
    lead="What's done, what's next, and the ideas we're exploring. Everything here is open for discussion."
  >
    <p><a class="link-arrow" href={repoLinks.discussions}>Join the discussion</a></p>
  </PageHead>
  <section class="section">
    <div class="container">
      <div class="prose md-body">
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>

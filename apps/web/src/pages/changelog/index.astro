---
import PageHead from "../../components/PageHead.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Content } from "../../../../../CHANGELOG.md";
import { repoLinks } from "../../data/site";
---

<BaseLayout title="Changelog" description="Every notable change to OpenDock, release by release.">
  <PageHead
    eyebrow="Release history"
    title="Changelog"
    lead="Every notable change, newest first. OpenDock follows semantic versioning; until 1.0, breaking changes are called out in each release."
  >
    <p><a class="link-arrow" href={repoLinks.releases}>Downloads for every release</a></p>
  </PageHead>
  <section class="section">
    <div class="container">
      <div class="prose md-body">
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>

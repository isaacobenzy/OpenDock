---
import BaseLayout from "../layouts/BaseLayout.astro";

const releaseTag = "v0.1.0-milestone-2";
const releaseBase = `https://github.com/isaacobenzy/OpenDock/releases/download/${releaseTag}`;
---

<BaseLayout
  title="Overview"
  description="OpenDock is an open-source, privacy-first smart dock for Windows, macOS, and Linux with live widgets, local automations, and no mandatory account."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="hero-badges">
          <span class="badge">MIT licensed</span>
          <span class="badge">Runs locally</span>
          <span class="badge">Cross-platform roadmap</span>
        </div>
        <h1>Not another taskbar clone. A dock you own.</h1>
        <p class="lead">
          OpenDock brings live widgets, layout persistence, and programmable automations to your
          desktop—without a subscription, license server, or hidden telemetry. Built with Tauri for
          Windows today; macOS and Linux builds follow the same open core.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/docs/#download">Download builds</a>
          <a class="btn btn-secondary" href="https://github.com/isaacobenzy/OpenDock">View on GitHub</a>
        </div>
      </div>
      <figure class="dock-preview">
        <img
          src="/screenshots/dock-windows.png"
          width="640"
          height="360"
          alt="OpenDock floating dock on Windows with clock and widget placeholders"
          loading="eager"
          decoding="async"
        />
        <figcaption class="screenshot-caption">Milestone 2 prototype on Windows</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>One project, every desktop</h2>
      <p class="section-intro">
        Installers are platform-specific; the product vision is not. OpenDock targets bundled
        <strong>.exe</strong>, <strong>.dmg</strong>, and Linux packages from the same repository.
      </p>
      <div class="card-grid">
        <article class="card">
          <h3>Windows</h3>
          <p>Milestone 2 prototype: floating dock, clock, persisted layout, fullscreen hide.</p>
          <a href={`${releaseBase}/OpenDock_0.1.0_x64-setup.exe`}>Download .exe installer</a>
        </article>
        <article class="card">
          <h3>macOS</h3>
          <p>.dmg packaging planned with Tauri bundler; not yet published for this milestone.</p>
        </article>
        <article class="card">
          <h3>Linux</h3>
          <p>.AppImage / .deb targets on the roadmap; build from source today.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Widgets that cooperate, not compete</h2>
      <p class="section-intro">
        Calendar, tasks, system health, and optional integrations share context so OpenDock can
        act before you open five different apps.
      </p>
      <div class="card-grid">
        <article class="card">
          <h3>Local automations</h3>
          <p>Event-condition-action rules run on your PC with quiet hours, cooldowns, and explicit permissions.</p>
        </article>
        <article class="card">
          <h3>Permissioned widget SDK</h3>
          <p>Built-in widgets ship first; extensions declare capabilities up front instead of getting full native access.</p>
        </article>
        <article class="card">
          <h3>Exportable setup</h3>
          <p>Back up layouts and settings, move between machines, and recover gracefully from invalid configuration.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container comparison">
      <h2>Why teams pick OpenDock</h2>
      <p class="section-intro">Inspired by the smart dock category, engineered for transparency and control.</p>
      <table>
        <thead>
          <tr>
            <th scope="col">Capability</th>
            <th scope="col">OpenDock</th>
            <th scope="col">Typical proprietary dock</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">License</th>
            <td>MIT, free forever</td>
            <td>Paid lifetime or subscription</td>
          </tr>
          <tr>
            <th scope="row">Platforms</th>
            <td>Windows (now); macOS/Linux (roadmap)</td>
            <td>Often single OS</td>
          </tr>
          <tr>
            <th scope="row">Account</th>
            <td>Not required</td>
            <td>Often required for activation</td>
          </tr>
          <tr>
            <th scope="row">Telemetry</th>
            <td>None by default</td>
            <td>Often unclear or bundled</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>

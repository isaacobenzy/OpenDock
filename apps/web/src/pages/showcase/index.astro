---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Showcase"
  description="Community dock layouts and widget boards built with OpenDock."
>
  <header class="page-header container">
    <h1>Showcase</h1>
    <p>Share your dock once Milestone 3 widgets ship. Until then, star the repo and watch releases.</p>
  </header>
  <section class="section">
    <div class="container card-grid">
      <article class="card">
        <h3>Founder focus board</h3>
        <p>Clock, tasks, and calendar in a bottom pill dock with quiet-hour automations.</p>
      </article>
      <article class="card">
        <h3>Developer status strip</h3>
        <p>Full-width top dock with system monitor and GitHub activity (coming soon).</p>
      </article>
      <article class="card">
        <h3>Minimal student bar</h3>
        <p>Compact dock with tasks and music controls when supported by the OS.</p>
      </article>
    </div>
  </section>
</BaseLayout>

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The dock bar",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-start-dragging",
    "dock-core",
    "widget-read",
    "widget-control",
    "apps-read",
    "apps-control",
    "navigation"
  ]
}

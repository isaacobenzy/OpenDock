{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main dock window capability",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "autostart:default",
    "allow-get-settings",
    "allow-save-settings",
    "allow-apply-dock-layout",
    "allow-get-current-monitor-id",
    "allow-quit-app",
    "allow-set-launch-at-startup"
  ]
}
